# Copy this file to .env and fill in the keys you have.
# Never commit the real .env file.

# --- LLM provider -----------------------------------------------------------
# Supported providers: gemini | openai | groq
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3-flash-preview

# Fallback, used when the primary model fails (overloaded, timeout, quota, bad JSON).
# A second Gemini model works with the same key. With an OpenAI key you can use
# LLM_FALLBACK_PROVIDER=openai / LLM_FALLBACK_MODEL=gpt-5-mini for provider-level redundancy.
LLM_FALLBACK_PROVIDER=gemini
LLM_FALLBACK_MODEL=gemini-3.1-flash-lite

GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Optional tuning
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1
LLM_MAX_OUTPUT_TOKENS=12000
LLM_TEMPERATURE=0.3
# Gemini 3.x models accept a thinking level (minimal | low | medium | high). Leave empty for the model default.
GEMINI_THINKING_LEVEL=low
# GPT-5 family accepts a reasoning effort (minimal | low | medium | high). Leave empty for the model default.
OPENAI_REASONING_EFFORT=low

# --- Website fetching -------------------------------------------------------
FETCH_TIMEOUT_SECONDS=12
MAX_EXTRA_PAGES=3
MAX_CONTENT_CHARS=14000
VERIFY_COMPETITOR_SITES=true

# --- Cache ------------------------------------------------------------------
CACHE_TTL_SECONDS=3600

LOG_LEVEL=INFO

# --- JavaScript-rendered sites (React / Vue / Angular) ------------------------
# Needs: pip install playwright && python -m playwright install chromium
ENABLE_JS_RENDERING=true
JS_RENDER_MIN_CHARS=400
JS_RENDER_TIMEOUT_SECONDS=20
JS_RENDER_MAX_CONCURRENT=2

# --- Abuse protection ---------------------------------------------------------
RATE_LIMIT_PER_MINUTE=10
